# 이 파일을 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.

# 서버 로그 출력 레벨. 요청 추적용 X-Request-Id 기록은 INFO 로 남는다.
LOG_LEVEL=INFO

# AI 기능(브레인덤프)이 사용하는 OpenAI 설정.
# 키가 비어 있으면 덤프 호출이 503(AI service unavailable)으로 실패한다.
# 응답이 최대 출력 토큰에서 잘리면 파싱에 실패해 같은 503이 된다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2048

# 대화 세션과 Idempotency-Key 응답 캐시의 보관 시간(초). 기본값은 둘 다 30분이다.
# 세션은 마지막 성공 요청, 캐시 항목은 마지막 사용을 기준으로 다시 센다.
SESSION_TTL_SECONDS=1800
IDEMPOTENCY_TTL_SECONDS=1800

# 프로세스가 한 번에 들고 있을 수 있는 세션·대화·멱등 응답의 상한.
# 넘어서는 요청은 429(Too many requests)로 거절한다.
MAX_SESSIONS=1000
MAX_SESSION_TURNS=50
MAX_SESSION_CONVERSATION_CHARS=50000
MAX_IDEMPOTENCY_ENTRIES=1000

# 프로세스 전체가 RATE_LIMIT_WINDOW_SECONDS 동안 받을 수 있는 LLM 요청 수.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
