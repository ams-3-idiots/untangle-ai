# 이 파일을 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.

# 서버 로그 출력 레벨. 요청 추적용 X-Request-Id 기록은 INFO 로 남는다.
LOG_LEVEL=INFO

# 기본값은 로컬 SQLite 파일이다.
DATABASE_URL=sqlite:///./untangle.db

# PostgreSQL 을 쓸 때는 아래 형식으로 바꾸고 psycopg 드라이버를 설치한다.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/untangle

# AI 기능(브레인덤프·할 일 쪼개기)이 사용하는 OpenAI 설정.
# 키가 비어 있으면 /api/v1/ai/* 호출이 503(AI service unavailable)으로 실패한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
