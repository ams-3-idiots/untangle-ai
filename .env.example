# 이 파일을 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.

# 서버 로그 출력 레벨. 요청 추적용 X-Request-Id 기록은 INFO 로 남는다.
LOG_LEVEL=INFO

# 기본값은 로컬 SQLite 파일이다.
DATABASE_URL=sqlite:///./untangle.db

# PostgreSQL 을 쓸 때는 아래 형식으로 바꾸고 psycopg 드라이버를 설치한다.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/untangle

# AI 기능(브레인덤프·할 일 쪼개기)이 사용하는 OpenAI 설정.
# 키가 비어 있으면 /api/v1/ai/* 호출이 503(AI service unavailable)으로 실패한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30

# 대화 세션과 Idempotency-Key 응답 캐시의 보관 시간(초). 기본값은 둘 다 30분이다.
# 세션은 마지막 성공 요청, 캐시 항목은 마지막 사용을 기준으로 다시 센다.
SESSION_TTL_SECONDS=1800
IDEMPOTENCY_TTL_SECONDS=1800

# 프로세스가 한 번에 들고 있을 수 있는 세션·대화·멱등 응답의 상한.
# 넘어서는 요청은 429(Too many requests)로 거절한다.
MAX_SESSIONS=1000
MAX_SESSION_TURNS=50
MAX_SESSION_CONVERSATION_CHARS=50000
MAX_IDEMPOTENCY_ENTRIES=1000

# 프로세스 전체가 RATE_LIMIT_WINDOW_SECONDS 동안 받을 수 있는 LLM 요청 수.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
